<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE log4j:configuration SYSTEM "log4j.dtd">
<!-- mule-health-api | master | CUSTOM corp pattern x2 | Expected: SUCCESS (replace-any) -->
<log4j:configuration xmlns:log4j="http://jakarta.apache.org/log4j/">
    <appender name="CONSOLE" class="org.apache.log4j.ConsoleAppender">
        <layout class="org.apache.log4j.PatternLayout">
            <PatternLayout pattern="%-4r [%t] %-5p %c %x - %m%n"/>
        </layout>
    </appender>
    <appender name="FILE" class="org.apache.log4j.RollingFileAppender">
        <param name="File" value="${app.home}/logs/mule-health-api.log"/>
        <layout class="org.apache.log4j.PatternLayout">
            <PatternLayout pattern="%-4r [%t] %-5p %c %x - %m%n"/>
        </layout>
    </appender>
    <root><priority value="INFO"/><appender-ref ref="CONSOLE"/><appender-ref ref="FILE"/></root>
</log4j:configuration>